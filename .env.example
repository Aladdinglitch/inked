# Public site URL used for metadata (OG/Twitter images, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://inkedattraction.com

# Optional external forwarding webhook. Keep server-side; never use NEXT_PUBLIC_ here.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Resend email delivery
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=Inked Attraction <bookings@yourdomain.com>
INQUIRY_TO_EMAIL=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=v20.0

# Distributed rate limiting (optional; memory fallback is used when absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
